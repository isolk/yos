{
    "configurations": [
        {
            "name": "Mac",
            "includePath": [
                "${workspaceFolder}/kernel/include",
                "${workspaceFolder}/system/include",
                "${workspaceFolder}/libc/include",
                "/opt/homebrew/Cellar/i686-elf-gcc/13.1.0/lib/gcc/i686-elf/13.1.0/*",
                "/opt/homebrew/Cellar/i686-elf-gcc/13.1.0/lib/gcc/i686-elf/13.1.0/include"
            ],
            "compilerPath": "/opt/homebrew/bin/i686-elf-gcc",
            "cStandard": "c99",
            "cppStandard": "c++98",
            "intelliSenseMode": "${default}",
            "compilerArgs": [
                "-g",
                "-c",
                "-std=gnu99",
                "-ffreestanding ",
                "-O0 ",
                "-Wall ",
                "-Wextra"
            ]
        }
    ],
    "version": 4
}